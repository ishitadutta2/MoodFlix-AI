# Copy this file's contents into a real .env (this one is safe to commit as a template)

# Flask
SECRET_KEY=dev-secret-key-change-me
FLASK_DEBUG=1
PORT=5000

# Gemini API (leave blank to use mock recommendations instead)
GEMINI_API_KEY=

# MongoDB Atlas (leave blank to use in-memory mock data instead)
MONGODB_URI=
MONGODB_DB=moodflix

# SMTP (leave blank to log "sent" emails to the console instead —
# used for password reset / email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@moodflix.ai
